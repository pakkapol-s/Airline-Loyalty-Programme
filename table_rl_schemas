-- Drop the table if it already exists, to remove the old primary key constraint
DROP TABLE IF EXISTS customer_flight_activity;

-- Recreate the table with the new column names (lowercase with underscores)
CREATE TABLE customer_flight_activity (
    loyalty_number INT NOT NULL, -- No quotes needed, PostgreSQL converts to lowercase
    year INT NOT NULL,
    month INT NOT NULL,
    flights_booked INT,
    flights_with_companions INT,
    total_flights INT,
    distance INT,
    points_accumulated FLOAT,
    points_redeemed INT,
    dollar_cost_points_redeemed INT,
    PRIMARY KEY (loyalty_number, year, month) -- Composite Primary Key
);

-- Drop the table if it already exists, to remove any old definition
DROP TABLE IF EXISTS customer_loyalty_history;

-- Create the table with appropriate data types and nullability
-- Increased NUMERIC precision for salary and clv
CREATE TABLE customer_loyalty_history (
    loyalty_number INT PRIMARY KEY,
    country VARCHAR(100) NOT NULL,
    province VARCHAR(100) NOT NULL,
    city VARCHAR(100) NOT NULL,
    postal_code VARCHAR(20) NOT NULL,
    gender VARCHAR(10) NOT NULL,
    education VARCHAR(50) NOT NULL,
    salary NUMERIC(15, 2), -- Increased from 10 to 15
    marital_status VARCHAR(20) NOT NULL,
    loyalty_card VARCHAR(20) NOT NULL,
    clv NUMERIC(15, 2) NOT NULL, -- Increased from 10 to 15
    enrollment_type VARCHAR(50) NOT NULL,
    enrollment_year INT NOT NULL,
    enrollment_month INT NOT NULL,
    cancellation_year INT,
    cancellation_month INT
);